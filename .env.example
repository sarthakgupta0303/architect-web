# =============================================================================
# Architect 2.0 — environment variables (engineering doc §6.1)
# Copy to .env.local for the web app. Values must never be committed.
# =============================================================================

# App
NEXT_PUBLIC_APP_URL=                  # Public origin of the web app, e.g. http://localhost:3000 or https://architect.new
MOCK_MODE=                            # "true" swaps build/deploy/GitHub/etc. services for seeded mocks (prototype); "false" in production
NEXT_PUBLIC_MOCK_MODE=                # Same flag exposed to the browser to show the "Demo data" badge

# Supabase
NEXT_PUBLIC_SUPABASE_URL=             # Supabase project URL — Project Settings > API
NEXT_PUBLIC_SUPABASE_ANON_KEY=        # Publishable (sb_publishable_…) or legacy anon key — Project Settings > API
SUPABASE_SERVICE_ROLE_KEY=            # SERVER ONLY — secret/service_role key, bypasses RLS — Project Settings > API
SUPABASE_PROJECT_REF=                 # SERVER ONLY — project ref (subdomain of the URL); used by Management API calls
SUPABASE_ACCESS_TOKEN=                # SERVER ONLY — personal access token for Management API (per-app databases) — Account > Access Tokens

# OAuth providers (configured in Supabase > Authentication > Providers; listed for local Supabase CLI)
SUPABASE_AUTH_GOOGLE_CLIENT_ID=       # SERVER ONLY — Google Cloud Console > APIs & Services > Credentials
SUPABASE_AUTH_GOOGLE_SECRET=          # SERVER ONLY — same OAuth client
SUPABASE_AUTH_GITHUB_CLIENT_ID=       # SERVER ONLY — GitHub > Settings > Developer settings > OAuth Apps
SUPABASE_AUTH_GITHUB_SECRET=          # SERVER ONLY — same OAuth App

# LLM gateway (LiteLLM proxy)
LITELLM_BASE_URL=                     # SERVER ONLY — URL of the self-hosted LiteLLM proxy, e.g. https://llm.internal.architect.dev
LITELLM_MASTER_KEY=                   # SERVER ONLY — LiteLLM master/virtual key used by platform services
ANTHROPIC_API_KEY=                    # SERVER ONLY — console.anthropic.com > API Keys (configured inside LiteLLM)
OPENAI_API_KEY=                       # SERVER ONLY — platform.openai.com > API keys (configured inside LiteLLM)
GOOGLE_GENERATIVE_AI_API_KEY=         # SERVER ONLY — aistudio.google.com > API keys (configured inside LiteLLM)
ARCHITECT_CHAT_MODEL=                 # SERVER ONLY — model id for the build-assistant chat (enables model answers; rule-based fallback when empty)
MAX_CHAT_HISTORY=100                  # SERVER ONLY — max conversation turns ever loaded for the model (default 100)
EMBEDDINGS_MODEL=                     # SERVER ONLY — embedding model id for code search, e.g. openai/text-embedding-3-small (1536 dims)

# Sandboxes (E2B)
E2B_API_KEY=                          # SERVER ONLY — e2b.dev dashboard > API Keys
E2B_TEMPLATE_ID=                      # SERVER ONLY — id of the Architect sandbox template built from infra/e2b/Dockerfile
PREVIEW_BASE_DOMAIN=                  # Wildcard domain for sandbox previews, e.g. preview.architect.dev

# Background jobs (Inngest)
INNGEST_EVENT_KEY=                    # SERVER ONLY — Inngest dashboard > Manage > Event keys
INNGEST_SIGNING_KEY=                  # SERVER ONLY — Inngest dashboard > Manage > Signing key

# Redis (Upstash) — rate limiting and caches
UPSTASH_REDIS_REST_URL=               # SERVER ONLY — Upstash console > Redis database > REST API
UPSTASH_REDIS_REST_TOKEN=             # SERVER ONLY — same page

# GitHub App (repo sync, PRs, webhooks)
GITHUB_APP_ID=                        # SERVER ONLY — GitHub > Settings > Developer settings > GitHub Apps > App ID
GITHUB_APP_SLUG=                      # Public slug of the app, used to build the install URL
GITHUB_APP_PRIVATE_KEY=               # SERVER ONLY — PEM private key generated on the GitHub App page (newlines as \n)
GITHUB_APP_CLIENT_ID=                 # SERVER ONLY — GitHub App client id
GITHUB_APP_CLIENT_SECRET=             # SERVER ONLY — GitHub App client secret
GITHUB_WEBHOOK_SECRET=                # SERVER ONLY — webhook secret set on the GitHub App
GITHUB_STATE_SECRET=                  # SERVER ONLY — random 32+ byte string used to HMAC-sign install state

# Deploy runtime (Fly.io)
FLY_API_TOKEN=                        # SERVER ONLY — `fly tokens create org` for the Architect apps org
FLY_ORG_SLUG=                         # SERVER ONLY — Fly organization slug that hosts user apps
APPS_BASE_DOMAIN=                     # Domain for deployed apps, e.g. architect.app
FLY_REGISTRY=                         # SERVER ONLY — registry host, e.g. registry.fly.io

# Secrets encryption (AWS KMS)
AWS_REGION=                           # SERVER ONLY — region of the KMS key, e.g. us-east-1
AWS_ACCESS_KEY_ID=                    # SERVER ONLY — IAM user/role with kms:Encrypt, kms:Decrypt, kms:GenerateDataKey
AWS_SECRET_ACCESS_KEY=                # SERVER ONLY — same IAM credentials
KMS_KEY_ID=                           # SERVER ONLY — ARN or alias of the symmetric KMS key, e.g. alias/architect-secrets

# Telemetry store (ClickHouse) — run spans and rollups
CLICKHOUSE_URL=                       # SERVER ONLY — https://<host>:8443 from ClickHouse Cloud > Connect
CLICKHOUSE_USER=                      # SERVER ONLY
CLICKHOUSE_PASSWORD=                  # SERVER ONLY
OTEL_EXPORTER_OTLP_ENDPOINT=          # SERVER ONLY — OpenTelemetry collector endpoint used by deployed app runtimes
OTEL_EXPORTER_OTLP_HEADERS=           # SERVER ONLY — auth header for the collector, e.g. authorization=Bearer …
INGEST_JWT_SECRET=                    # SERVER ONLY — HMAC secret for service JWTs (runtime -> /api/ingest/*), 32+ bytes

# Integrations OAuth broker (Nango)
NANGO_HOST=                           # SERVER ONLY — URL of self-hosted Nango, e.g. https://nango.internal.architect.dev
NANGO_SECRET_KEY=                     # SERVER ONLY — Nango > Environment settings > Secret key
NEXT_PUBLIC_NANGO_PUBLIC_KEY=         # Nango public key for the frontend connect UI

# Email (Resend)
RESEND_API_KEY=                       # SERVER ONLY — resend.com > API Keys
EMAIL_FROM=                           # Verified sender, e.g. "Architect <no-reply@architect.new>"

# Payments (Stripe)
STRIPE_SECRET_KEY=                    # SERVER ONLY — dashboard.stripe.com > Developers > API keys
STRIPE_WEBHOOK_SECRET=                # SERVER ONLY — Developers > Webhooks > endpoint signing secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=   # Developers > API keys > Publishable key
STRIPE_PRICE_PRO_MONTHLY=             # SERVER ONLY — Price id for Pro $25/month
STRIPE_PRICE_PRO_YEARLY=              # SERVER ONLY — Price id for Pro yearly
STRIPE_PRICE_TEAM_MONTHLY=            # SERVER ONLY — Price id for Team $40/user/month
STRIPE_PRICE_TEAM_YEARLY=             # SERVER ONLY — Price id for Team yearly
STRIPE_PRICE_CREDITS_100=             # SERVER ONLY — one-time price for 100 credits
STRIPE_PRICE_CREDITS_500=             # SERVER ONLY — one-time price for 500 credits
STRIPE_PRICE_CREDITS_2000=            # SERVER ONLY — one-time price for 2,000 credits

# Error monitoring and analytics
NEXT_PUBLIC_SENTRY_DSN=               # Sentry > Project settings > Client keys (DSN)
SENTRY_AUTH_TOKEN=                    # SERVER ONLY — source map upload token (CI only)
NEXT_PUBLIC_POSTHOG_KEY=              # PostHog project API key (feature flags + product analytics)
NEXT_PUBLIC_POSTHOG_HOST=             # e.g. https://us.i.posthog.com

# Secrets encryption (prototype, replaces KMS locally)
SECRETS_ENCRYPTION_KEY=               # SERVER ONLY — 32-byte base64 AES-256-GCM key for project secrets; generate with `openssl rand -base64 32`. Rotating it makes existing secrets unreadable.
